#!/usr/bin/env bash
# Fetch a GitHub Actions workflow run or job.
# Usage:
#   github-job run <run id or URL>   List the failed jobs in the run.
#   github-job log <job id or URL>   Print the log of the job.
#   github-job info <job id or URL>  Print the metadata of the job.
set -euo pipefail

usage() {
  echo "Usage: github-job run <run id or URL> | log <job id or URL> | info <job id or URL>" >&2
  exit 2
}
[[ $# -eq 2 ]] || usage

repo="City-of-Helsinki/tilavarauspalvelu-core"
runs_url='https://github\.com/City-of-Helsinki/tilavarauspalvelu-core/actions/runs'

case "$1" in
  run)
    if [[ "$2" =~ ^([0-9]+)$ || "$2" =~ ^$runs_url/([0-9]+)([/?#].*)?$ ]]; then
      run_id="${BASH_REMATCH[1]}"
    else
      echo "Not a run id or URL: $2" >&2
      usage
    fi
    gh run view "$run_id" --repo "$repo" --json databaseId,status,conclusion,url,jobs \
      --jq '{run: {id: .databaseId, status, conclusion, url}, jobs: [.jobs[] | select(.conclusion=="failure") | {id: .databaseId, name, status, conclusion, url}]}'
    ;;
  log | info)
    if [[ "$2" =~ ^([0-9]+)$ || "$2" =~ ^$runs_url/[0-9]+/job/([0-9]+)([/?#].*)?$ ]]; then
      job_id="${BASH_REMATCH[1]}"
    else
      echo "Not a job id or URL: $2" >&2
      usage
    fi
    if [[ "$1" == log ]]; then
      gh run view --job "$job_id" --repo "$repo" --log
    else
      gh api "repos/$repo/actions/jobs/$job_id" --jq '{id, name, status, conclusion, started_at, completed_at, html_url}'
    fi
    ;;
  *)
    usage
    ;;
esac
