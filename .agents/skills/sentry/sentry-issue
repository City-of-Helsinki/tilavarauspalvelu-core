#!/usr/bin/env bash
# Fetch a Sentry issue with one of its events from the Sentry REST API.
# The event is the one in the URL, or the latest event if the URL has none.
# Tag keys after the issue add the top values of each tag over all events of the issue.
# The token is read from 1Password.
# Usage: sentry-issue <issue ID or URL> [tag key ...], e.g. sentry-issue 153768154 browser.name os.name
set -euo pipefail

source "$(dirname "$0")/lib.sh"

usage() {
  echo "Usage: sentry-issue <issue ID or URL> [tag key ...], e.g. sentry-issue 153768154 browser.name os.name" >&2
  exit 2
}
[[ $# -ge 1 ]] || usage

parse_issue "$1" || usage
shift

for key in "$@"; do
  if [[ ! "$key" =~ ^[A-Za-z0-9_.:-]+$ ]]; then
    echo "Not a Sentry tag key: $key" >&2
    usage
  fi
done

load_token

issue="$(api "issues/$issue_id/")"
event="$(api "issues/$issue_id/events/$event_id/")"
tags="$(for key in "$@"; do api "issues/$issue_id/tags/$key/"; done | jq --slurp '.')"

jq --slurp '.[0] as $issue | .[1] as $event | .[2] as $tags | {
  id: $issue.id,
  short_id: $issue.shortId,
  url: $issue.permalink,
  title: $issue.title,
  culprit: $issue.culprit,
  level: $issue.level,
  status: $issue.status,
  substatus: $issue.substatus,
  project: $issue.project.slug,
  assignee: $issue.assignedTo.name,
  first_seen: $issue.firstSeen,
  last_seen: $issue.lastSeen,
  event_count: $issue.count,
  user_count: $issue.userCount,
  tags: [$tags[] | {
    key,
    total: .totalValues,
    unique: .uniqueValues,
    top: [.topValues[] | {value, count}]
  }],
  event: {
    id: $event.eventID,
    at: $event.dateCreated,
    message: $event.message,
    tags: ([$event.tags[] | {(.key): .value}] | add),
    request: ([$event.entries[] | select(.type == "request") | .data | {method, url}] | first),
    # Frames are oldest first. Only in-app frames have code context.
    # Performance issues, such as N+1 queries, have evidence instead of exceptions.
    evidence: ($event.occurrence | if . then {
      parent_span: .evidenceData.parentSpan,
      repeating_spans: .evidenceData.repeatingSpansCompact,
      repetitions: .evidenceData.numPatternRepetitions,
      offending_spans: [.evidenceDisplay[]? | .value]
    } else null end),
    exceptions: [$event.entries[] | select(.type == "exception") | .data.values[] | {
      type,
      value,
      module,
      frames: [.stacktrace.frames[]? | {
        file: (.filename // .absPath),
        function,
        line: .lineNo,
        in_app: .inApp,
        context: (if .inApp then [.context[]? | "\(.[0]): \(.[1])"] else null end)
      }]
    }],
    breadcrumbs: ([$event.entries[] | select(.type == "breadcrumbs") | .data.values[]
      | {at: .timestamp, category, level, message}] | .[-20:])
  }
}' <(printf '%s' "$issue") <(printf '%s' "$event") <(printf '%s' "$tags")
