#!/usr/bin/env bash
# Fetch a Sentry issue with one of its events from the Sentry REST API.
# The event is the one in the URL, or the latest event if the URL has none.
# Tag keys after the issue add the top values of each tag over all events of the issue.
# With --events, the script lists all events of the issue instead. Each event has the values of the tag keys.
# With --environment, the script uses only the events of that environment, for example production.
# The token is read from the secret file or from 1Password. See lib.sh.
# Usage: sentry-issue [--events] [--environment <name>] <issue ID or URL> [tag key ...],
#   e.g. sentry-issue --environment production 153768154 browser.name os.name
set -euo pipefail

source "$(dirname "$0")/lib.sh"

usage() {
  cat >&2 <<'EOF'
Usage: sentry-issue [--events] [--environment <name>] <issue ID or URL> [tag key ...]
  --events              List all events of the issue, not one event.
  --environment <name>  Use only the events of this environment, for example production.
e.g. sentry-issue --environment production 153768154 browser.name os.name
EOF
  exit 2
}

list_events=false
environment=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --events) list_events=true; shift ;;
    --environment)
      [[ $# -ge 2 ]] || usage
      environment="$2"
      shift 2
      ;;
    --*) echo "Unknown option: $1" >&2; usage ;;
    *) break ;;
  esac
done
[[ $# -ge 1 ]] || usage

if [[ -n "$environment" && ! "$environment" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  echo "Not a Sentry environment name: $environment" >&2
  usage
fi
# The query parameter for the API calls. It is empty without --environment.
env_param="${environment:+environment=$environment}"

parse_issue "$1" || usage
shift

for key in "$@"; do
  if [[ ! "$key" =~ ^[A-Za-z0-9_.:-]+$ ]]; then
    echo "Not a Sentry tag key: $key" >&2
    usage
  fi
done

load_token

if $list_events; then
  # Sentry gives 100 events on a page. Stop after max_pages, so that a large issue does not run for long.
  max_pages=20
  keys=("$@")
  [[ ${#keys[@]} -gt 0 ]] || keys=(environment url transaction release)

  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' EXIT

  cursor=""
  page=0
  truncated=false
  while :; do
    page=$((page + 1))
    api "issues/$issue_id/events/?full=true${env_param:+&$env_param}${cursor:+&cursor=$cursor}" \
      --dump-header "$tmp_dir/headers" >"$tmp_dir/page-$(printf '%03d' "$page").json"
    # The Link header has the next cursor. results="true" tells that the next page has events.
    next="$(grep -io 'rel="next"; *results="true"; *cursor="[^"]*"' "$tmp_dir/headers" || true)"
    [[ -n "$next" ]] || break
    if [[ $page -ge $max_pages ]]; then
      truncated=true
      break
    fi
    cursor="$(sed -E 's/.*cursor="([^"]*)".*/\1/' <<<"$next")"
  done

  keys_json="$(printf '%s\n' "${keys[@]}" | jq --raw-input . | jq --slurp .)"
  jq --slurp --argjson keys "$keys_json" --argjson truncated "$truncated" '
    [.[][]] as $events | {
      count: ($events | length),
      truncated: $truncated,
      events: [$events[] | ([.tags[]? | {(.key): .value}] | add // {}) as $tags | {
        id: .eventID,
        at: .dateCreated,
        tags: ([$keys[] | {(.): $tags[.]}] | add),
        message: .message,
        # Sentry lists the chained exceptions root cause first. Take the outermost one that has a message,
        # because a wrapper exception often has no message.
        exception: ([.entries[]? | select(.type == "exception") | .data.values[]
          | select(.value != null) | "\(.type): \(.value)"] | last)
      }]
    }' "$tmp_dir"/page-*.json
  exit 0
fi

# With --environment, the first and last seen times, the latest event and the tag counts are for that environment.
# Sentry does not filter event_count and user_count. They stay the totals over all environments.
# An event ID from the URL selects that event, also when it is from another environment.
issue="$(api "issues/$issue_id/${env_param:+?$env_param}")"
event="$(api "issues/$issue_id/events/$event_id/${env_param:+?$env_param}")"
tags="$(for key in "$@"; do api "issues/$issue_id/tags/$key/${env_param:+?$env_param}"; done | jq --slurp '.')"

jq --slurp '.[0] as $issue | .[1] as $event | .[2] as $tags | {
  id: $issue.id,
  short_id: $issue.shortId,
  url: $issue.permalink,
  title: $issue.title,
  culprit: $issue.culprit,
  level: $issue.level,
  status: $issue.status,
  substatus: $issue.substatus,
  project: $issue.project.slug,
  assignee: $issue.assignedTo.name,
  first_seen: $issue.firstSeen,
  last_seen: $issue.lastSeen,
  event_count: $issue.count,
  user_count: $issue.userCount,
  tags: [$tags[] | {
    key,
    total: .totalValues,
    unique: .uniqueValues,
    top: [.topValues[] | {value, count}]
  }],
  event: {
    id: $event.eventID,
    at: $event.dateCreated,
    message: $event.message,
    tags: ([$event.tags[] | {(.key): .value}] | add),
    request: ([$event.entries[] | select(.type == "request") | .data | {method, url}] | first),
    # Frames are oldest first. Only in-app frames have code context.
    # Performance issues, such as N+1 queries, have evidence instead of exceptions.
    evidence: ($event.occurrence | if . then {
      parent_span: .evidenceData.parentSpan,
      repeating_spans: .evidenceData.repeatingSpansCompact,
      repetitions: .evidenceData.numPatternRepetitions,
      offending_spans: [.evidenceDisplay[]? | .value]
    } else null end),
    exceptions: [$event.entries[] | select(.type == "exception") | .data.values[] | {
      type,
      value,
      module,
      frames: [.stacktrace.frames[]? | {
        file: (.filename // .absPath),
        function,
        line: .lineNo,
        in_app: .inApp,
        context: (if .inApp then [.context[]? | "\(.[0]): \(.[1])"] else null end)
      }]
    }],
    breadcrumbs: ([$event.entries[] | select(.type == "breadcrumbs") | .data.values[]
      | {at: .timestamp, category, level, message}] | .[-20:])
  }
}' <(printf '%s' "$issue") <(printf '%s' "$event") <(printf '%s' "$tags")
