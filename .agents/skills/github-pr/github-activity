#!/usr/bin/env bash
# List the pull requests that you or the whole team opened, merged or reviewed in a date window.
# Usage: github-activity [--team] [--since <date>] [--until <date>] [--summary-only]
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: github-activity [--team] [--since <date>] [--until <date>] [--summary-only]
  --team            All people (not bots), with totals for the team. Without it, your own work.
  --since <date>    The first day, YYYY-MM-DD. Default: 14 days ago.
  --until <date>    The last day, YYYY-MM-DD. Default: today.
  --summary-only    Print only the counts, not the pull requests.
EOF
  exit 2
}

# The script shows only your own work or the team totals, not the work of another person.
# The team agreed on this. Do not add an option for another person.
repo="City-of-Helsinki/tilavarauspalvelu-core"
team=false
since=""
until_date=""
summary_only=false

while [[ $# -gt 0 ]]; do
  option="$1"
  shift
  case "$option" in
    --team) team=true ;;
    --summary-only) summary_only=true ;;
    --since | --until)
      [[ $# -ge 1 ]] || { echo "Missing value for $option" >&2; usage; }
      [[ "$option" == --since ]] && since="$1" || until_date="$1"
      shift
      ;;
    *) echo "Unknown option: $option" >&2; usage ;;
  esac
done

# GNU date takes -d. BSD date on macOS takes -v.
[[ -n "$since" ]] || since="$(date -d '-14 days' +%F 2>/dev/null || date -v-14d +%F)"
[[ -n "$until_date" ]] || until_date="$(date +%F)"
for day in "$since" "$until_date"; do
  [[ "$day" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "Not a date in the form YYYY-MM-DD: $day" >&2; usage; }
done
[[ ! "$since" > "$until_date" ]] || { echo "--since $since is after --until $until_date." >&2; exit 2; }

# Search for the pull requests that changed in or after the window. The filter below keeps the ones in the window.
query='
query($q: String!, $endCursor: String) {
  search(query: $q, type: ISSUE, first: 50, after: $endCursor) {
    pageInfo { hasNextPage endCursor }
    nodes {
      ... on PullRequest {
        number title url state isDraft createdAt mergedAt headRefName baseRefName additions deletions body
        author { login __typename }
        reviews(first: 100) { nodes { author { login __typename } state submittedAt } }
      }
    }
  }
}'
search() {
  gh api graphql --paginate -f query="$query" -f q="repo:$repo is:pr updated:>=$since $1" \
    --jq '.data.search.nodes[]' | jq --slurp 'unique_by(.number)'
}
if [[ "$team" == true ]]; then
  me=""
  prs="$(search "")"
else
  me="$(gh api user --jq .login)"
  prs="$(jq --slurp 'add | unique_by(.number)' <(search "author:@me") <(search "reviewed-by:@me"))"
fi

# GitHub gives the times in UTC. The first 10 characters are the date in UTC.
jq --arg since "$since" --arg until "$until_date" --arg me "$me" --argjson summary_only "$summary_only" '
  def in_window: . != null and .[0:10] >= $since and .[0:10] <= $until;
  def team: $me == "";
  # Bots are of type Bot. Dependabot also shows as the login dependabot.
  def human: . != null and .__typename == "User" and .login != "dependabot";
  def counted: human and (team or .login == $me);
  def open: .state == "OPEN" or .state == "DRAFT";

  map(
    .author.login as $pr_author
    | {
      number,
      title,
      url,
      author: .author.login,
      author_counted: (.author | counted),
      state: (if .isDraft and .state == "OPEN" then "DRAFT" else .state end),
      created: .createdAt[0:10],
      merged: (.mergedAt // null | if . then .[0:10] else null end),
      branch: .headRefName,
      base: .baseRefName,
      size: "+\(.additions)/-\(.deletions)",
      jira: ([(.title + " " + .headRefName + " " + (.body // "")) | scan("TILA-[0-9]+")] | unique),
      reviews: [
        .reviews.nodes[]
        # A comment of the author in their own pull request shows as a review. Skip it.
        | select((.author | counted) and .author.login != $pr_author and (.submittedAt | in_window))
        | {at: .submittedAt[0:16], state}
      ]
    }
  )
  | {
      authored: map(
          select(.author_counted and .created <= $until and ((.created | in_window) or (.merged | in_window) or open))
          | del(.author_counted, .reviews)
        ),
      reviewed: map(
          select(.reviews != [] and (team or .author != $me))
          | del(.author_counted, .branch, .base, .size)
        )
    }
  # The team output does not name the persons.
  | if team then (.authored, .reviewed) |= map(del(.author)) else . end
  | . as $lists
  | {
      who: (if team then "team" else $me end),
      since: $since,
      until: $until,
      summary: {
        opened: [$lists.authored[] | select(.created | in_window)] | length,
        merged: [$lists.authored[] | select(.merged | in_window)] | length,
        open_now: [$lists.authored[] | select(open)] | length,
        reviewed_prs: $lists.reviewed | length,
        reviews: [$lists.reviewed[].reviews[]] | length
      }
    }
    + (if $summary_only then {} else $lists end)
' <<<"$prs"
