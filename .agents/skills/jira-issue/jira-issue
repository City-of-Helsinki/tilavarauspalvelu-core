#!/usr/bin/env bash
# Fetch a Jira issue with all its comments from the Jira Cloud REST API.
# Credentials are read from 1Password.
# Usage: jira-issue <key or URL>, e.g. jira-issue TILA-123
set -euo pipefail

usage() {
  echo "Usage: jira-issue <key or URL>, e.g. jira-issue TILA-123" >&2
  exit 2
}
[[ $# -eq 1 ]] || usage

base_url="https://helsinkisolutionoffice.atlassian.net"
host='https://helsinkisolutionoffice\.atlassian\.net'
key_pattern='[A-Z][A-Z0-9]*-[0-9]+'

if [[ "$1" =~ ^($key_pattern)$ ]]; then
  key="${BASH_REMATCH[1]}"
elif [[ "$1" =~ ^$host/browse/($key_pattern)([?#].*)?$ ]]; then
  key="${BASH_REMATCH[1]}"
elif [[ "$1" =~ ^$host/[^?#]*\?(.*\&)?selectedIssue=($key_pattern)([\&#].*)?$ ]]; then
  key="${BASH_REMATCH[2]}"
else
  echo "Not a Jira issue key or URL: $1" >&2
  usage
fi

: "${JIRA_ISSUE_OP_ACCOUNT:?Set JIRA_ISSUE_OP_ACCOUNT to your 1Password account, e.g. vincit.1password.eu}"
vault="${JIRA_ISSUE_OP_VAULT:-Private}"
item="${JIRA_ISSUE_OP_ITEM:-Jira API key}"
ref="op://$vault/$item"

user="$(op read --account "$JIRA_ISSUE_OP_ACCOUNT" "$ref/username")"
token="$(op read --account "$JIRA_ISSUE_OP_ACCOUNT" "$ref/credential")"

api() {
  # Pass credentials through stdin so they do not show up in the process list.
  printf 'user = "%s:%s"\n' "$user" "$token" \
    | curl --silent --show-error --fail-with-body --config - "$base_url/$1"
}

fields="summary,status,issuetype,priority,assignee,reporter,labels,parent,created,updated,description,comment"
issue="$(api "rest/api/2/issue/$key?fields=$fields")"

# The issue has only the first page of comments. Fetch the rest.
comments="$(jq '.fields.comment.comments' <<<"$issue")"
total="$(jq '.fields.comment.total' <<<"$issue")"
while (( $(jq length <<<"$comments") < total )); do
  page="$(api "rest/api/2/issue/$key/comment?startAt=$(jq length <<<"$comments")")"
  [[ "$(jq '.comments | length' <<<"$page")" -gt 0 ]] || break
  comments="$(jq --slurp '.[0] + .[1].comments' <(printf '%s' "$comments") <(printf '%s' "$page"))"
done

jq --slurp --arg base "$base_url" '.[0] as $issue | .[1] as $comments | $issue | {
  key,
  url: "\($base)/browse/\(.key)",
  summary: .fields.summary,
  type: .fields.issuetype.name,
  status: .fields.status.name,
  priority: .fields.priority.name,
  assignee: .fields.assignee.displayName,
  reporter: .fields.reporter.displayName,
  labels: .fields.labels,
  parent: .fields.parent.key,
  created: .fields.created,
  updated: .fields.updated,
  description: .fields.description,
  comments: [$comments[] | {author: .author.displayName, at: .created, body}]
}' <(printf '%s' "$issue") <(printf '%s' "$comments")
