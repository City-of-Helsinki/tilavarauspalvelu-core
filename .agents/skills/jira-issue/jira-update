#!/usr/bin/env bash
# Update the summary, description, parent, labels, links, assignee or status of a Jira issue, or add a comment, through the Jira Cloud REST API.
# Usage: jira-update <key or URL> <options>, e.g. jira-update TILA-123 --add-label backend
set -euo pipefail

source "$(dirname "$0")/lib.sh"

usage() {
  cat >&2 <<'EOF'
Usage: jira-update <key or URL> <options>, e.g. jira-update TILA-123 --add-label backend
Give at least one change. Options marked with * can be repeated.
  --summary <text>            Replace the summary (the title). One line.
  --description-file <path>   Replace the description with the file contents (Jira wiki markup).
  --comment-file <path>       Add a comment with the file contents (Jira wiki markup).
  --parent <key>              Move the issue under this parent, usually an epic.
  --add-label <label>       * Add a label: backend, frontend, operations, infra or design.
  --remove-label <label>    * Remove a label.
  --blocks <key>            * Add a link: this issue blocks <key>.
  --blocked-by <key>        * Add a link: this issue is blocked by <key>.
  --relates <key>           * Add a link: this issue relates to <key>.
  --remove-link <key>       * Remove every link between this issue and <key>.
  --assignee <user>           Assign the issue: me, none, or the Jira name of a team member.
  --transition <status>       Move the issue to this status, e.g. Done. Runs last, after the other changes.
  --dry-run                   Print the write requests and change nothing in Jira.
EOF
  exit 2
}
[[ $# -ge 2 ]] || usage

key="$(parse_key "$1")"
shift

new_summary=""
description_file=""
comment_file=""
parent=""
add_labels=()
remove_labels=()
blocks=()
blocked_by=()
relates=()
remove_links=()
transition=""
assignee=""
dry_run=false

# The team members that --assignee accepts, by their Jira display name.
# The Jira user search finds hundreds of users across the City, so the script accepts only these names.
# Keep this list the same as the team table in SKILL.md.
team=(
  "Matti Lamppu"
  "Joonatan Kuosa"
  "Mats Eriksson"
  "Eemeli Ranta"
  "noora.alikirri"
  "Juvonen Jesse"
  "Tuomas Alahäivälä"
  "Tuomas Haapala"
)

while [[ $# -gt 0 ]]; do
  option="$1"
  if [[ "$option" == "--dry-run" ]]; then
    dry_run=true
    shift
    continue
  fi
  [[ $# -ge 2 ]] || { echo "Missing value for $option" >&2; usage; }
  value="$2"
  shift 2
  case "$option" in
    --summary)
      [[ -z "$new_summary" ]] || { echo "Give --summary only once." >&2; usage; }
      [[ -n "${value//[[:space:]]/}" ]] || { echo "The summary is empty." >&2; exit 2; }
      [[ "$value" != *$'\n'* ]] || { echo "The summary must be one line." >&2; exit 2; }
      new_summary="$value"
      ;;
    --description-file)
      [[ -z "$description_file" ]] || { echo "Give --description-file only once." >&2; usage; }
      check_text_file "$value" description
      description_file="$value"
      ;;
    --comment-file)
      [[ -z "$comment_file" ]] || { echo "Give --comment-file only once." >&2; usage; }
      check_text_file "$value" comment
      comment_file="$value"
      ;;
    --parent)
      [[ -z "$parent" ]] || { echo "Give --parent only once." >&2; usage; }
      parent="$(parse_key "$value")"
      [[ "$parent" != "$key" ]] || { echo "Cannot make $key its own parent." >&2; exit 2; }
      ;;
    --assignee)
      [[ -z "$assignee" ]] || { echo "Give --assignee only once." >&2; usage; }
      [[ -n "${value//[[:space:]]/}" ]] || { echo "The assignee is empty." >&2; exit 2; }
      # Keep "me" and "none" in lower case. Change a team member to the Jira name in the team list.
      lower_value="$(tr '[:upper:]' '[:lower:]' <<<"$value")"
      if [[ "$lower_value" == me || "$lower_value" == none ]]; then
        assignee="$lower_value"
      else
        for member in "${team[@]}"; do
          [[ "$(tr '[:upper:]' '[:lower:]' <<<"$member")" != "$lower_value" ]] || assignee="$member"
        done
        if [[ -z "$assignee" ]]; then
          echo "The assignee $value is not in the team list. Give me, none or one of these Jira names:" >&2
          printf '  %s\n' "${team[@]}" >&2
          exit 2
        fi
      fi
      ;;
    --transition)
      [[ -z "$transition" ]] || { echo "Give --transition only once." >&2; usage; }
      [[ -n "${value//[[:space:]]/}" ]] || { echo "The status is empty." >&2; exit 2; }
      transition="$value"
      ;;
    --add-label | --remove-label)
      check_label "$value"
      if [[ "$option" == "--add-label" ]]; then add_labels+=("$value"); else remove_labels+=("$value"); fi
      ;;
    --blocks | --blocked-by | --relates | --remove-link)
      other="$(parse_key "$value")"
      [[ "$other" != "$key" ]] || { echo "Cannot link $key to itself." >&2; exit 2; }
      case "$option" in
        --blocks) blocks+=("$other") ;;
        --blocked-by) blocked_by+=("$other") ;;
        --relates) relates+=("$other") ;;
        --remove-link) remove_links+=("$other") ;;
      esac
      ;;
    *)
      echo "Unknown option: $option" >&2
      usage
      ;;
  esac
done

for label in ${add_labels[@]+"${add_labels[@]}"}; do
  ! contains "$label" ${remove_labels[@]+"${remove_labels[@]}"} \
    || { echo "Label $label is both added and removed." >&2; exit 2; }
done
for other in ${remove_links[@]+"${remove_links[@]}"}; do
  ! contains "$other" ${blocks[@]+"${blocks[@]}"} ${blocked_by[@]+"${blocked_by[@]}"} ${relates[@]+"${relates[@]}"} \
    || { echo "Link to $other is both added and removed." >&2; exit 2; }
done

if [[ -z "$new_summary" && -z "$description_file" && -z "$comment_file" && -z "$parent" && -z "$assignee" && -z "$transition" ]] \
  && (( ${#add_labels[@]} + ${#remove_labels[@]} + ${#blocks[@]} + ${#blocked_by[@]} + ${#relates[@]} + ${#remove_links[@]} == 0 )); then
  echo "Nothing to change." >&2
  usage
fi

load_credentials

# The current summary, parent, labels and links decide what to skip and which link IDs to remove.
issue="$(api "rest/api/2/issue/$key?fields=summary,parent,labels,issuelinks,assignee,status")"

# Each request is "<method><sep><path><sep><body><sep><summary>".
# The separator is not whitespace, so `read` keeps an empty body as an empty field.
sep=$'\x1f'
requests=()
skipped=()

# Summary, description, parent and labels go in one edit request. The REST API v2 stores the description as wiki markup.
edit_summary=()
if [[ -n "$new_summary" ]] && [[ "$(jq --raw-output '.fields.summary' <<<"$issue")" == "$new_summary" ]]; then
  skipped+=("The summary of $key is already as requested.")
  new_summary=""
fi
if [[ -n "$parent" ]]; then
  old_parent="$(jq --raw-output '.fields.parent.key // ""' <<<"$issue")"
  if [[ "$old_parent" == "$parent" ]]; then
    skipped+=("The parent of $key is already $parent.")
    parent=""
  else
    edit_summary+=("Changed the parent from ${old_parent:-none} to $parent.")
  fi
fi
labels_to_add=()
labels_to_remove=()
for label in ${add_labels[@]+"${add_labels[@]}"}; do
  if jq --exit-status --arg l "$label" '.fields.labels | index($l)' <<<"$issue" >/dev/null; then
    skipped+=("Label $label is already on $key.")
  elif ! contains "$label" ${labels_to_add[@]+"${labels_to_add[@]}"}; then
    labels_to_add+=("$label")
    edit_summary+=("Added label $label.")
  fi
done
for label in ${remove_labels[@]+"${remove_labels[@]}"}; do
  if ! jq --exit-status --arg l "$label" '.fields.labels | index($l)' <<<"$issue" >/dev/null; then
    skipped+=("Label $label is not on $key.")
  elif ! contains "$label" ${labels_to_remove[@]+"${labels_to_remove[@]}"}; then
    labels_to_remove+=("$label")
    edit_summary+=("Removed label $label.")
  fi
done
[[ -z "$description_file" ]] || edit_summary=("Replaced the description." ${edit_summary[@]+"${edit_summary[@]}"})
[[ -z "$new_summary" ]] || edit_summary=("Changed the summary to \"$new_summary\"." ${edit_summary[@]+"${edit_summary[@]}"})

if (( ${#edit_summary[@]} > 0 )); then
  body="$(
    jq --null-input --compact-output \
      --arg summary "$new_summary" \
      --arg parent "$parent" \
      --arg has_description "$([[ -n "$description_file" ]] && echo true || echo false)" \
      --rawfile description "${description_file:-/dev/null}" \
      --argjson add "$(jq --null-input --compact-output '$ARGS.positional' --args ${labels_to_add[@]+"${labels_to_add[@]}"})" \
      --argjson remove "$(jq --null-input --compact-output '$ARGS.positional' --args ${labels_to_remove[@]+"${labels_to_remove[@]}"})" \
      '{}
      | if $summary != "" then .fields.summary = $summary else . end
      | if $has_description == "true" then .fields.description = $description else . end
      | if $parent != "" then .fields.parent = {key: $parent} else . end
      | ([$add[] | {add: .}] + [$remove[] | {remove: .}]) as $ops
      | if ($ops | length) > 0 then .update.labels = $ops else . end'
  )"
  summary="$(printf '%s ' ${edit_summary[@]+"${edit_summary[@]}"})"
  requests+=("PUT${sep}rest/api/2/issue/$key$sep$body$sep${summary% }")
fi

if [[ -n "$comment_file" ]]; then
  body="$(jq --null-input --compact-output --rawfile comment "$comment_file" '{body: $comment}')"
  requests+=("POST${sep}rest/api/2/issue/$key/comment$sep$body${sep}Added a comment.")
fi

# Remove links before adding new ones.
for other in ${remove_links[@]+"${remove_links[@]}"}; do
  found="$(
    jq --raw-output --arg k "$key" --arg o "$other" '
      .fields.issuelinks[]
      | select(.inwardIssue.key == $o or .outwardIssue.key == $o)
      | if .outwardIssue then "\(.id)\t\($k) \(.type.outward) \($o)"
        else "\(.id)\t\($o) \(.type.outward) \($k)" end' <<<"$issue"
  )"
  if [[ -z "$found" ]]; then
    skipped+=("No link between $key and $other.")
    continue
  fi
  while IFS=$'\t' read -r id text; do
    requests+=("DELETE${sep}rest/api/2/issueLink/$id$sep${sep}Removed link: $text.")
  done <<<"$found"
done

# Add a link request unless the link exists. `exists` selects the existing link in this issue.
# See make_link in lib.sh for the link direction.
add_link() {
  local option="$1" other="$2" exists="$3" request
  make_link "$option" "$key" "$other"
  if jq --exit-status --arg t "$link_type" --arg o "$other" "[.fields.issuelinks[] | select(.type.name == \$t) | select($exists)] | length > 0" <<<"$issue" >/dev/null; then
    skipped+=("Link already exists: $link_text.")
    return
  fi
  # Skip duplicates in the arguments.
  for request in ${requests[@]+"${requests[@]}"}; do
    [[ "$request" == *"$sep$link_body$sep"* ]] && return
  done
  requests+=("POST${sep}rest/api/2/issueLink$sep$link_body${sep}Added link: $link_text.")
}
for other in ${blocks[@]+"${blocks[@]}"}; do
  add_link --blocks "$other" '.outwardIssue.key == $o'
done
for other in ${blocked_by[@]+"${blocked_by[@]}"}; do
  add_link --blocked-by "$other" '.inwardIssue.key == $o'
done
for other in ${relates[@]+"${relates[@]}"}; do
  add_link --relates "$other" '.outwardIssue.key == $o or .inwardIssue.key == $o'
done

# Change the assignee before the status, because a workflow can require an assignee for a status.
# "me" is the owner of the API token. "none" removes the assignee. Any other value must be a name in the team list.
if [[ -n "$assignee" ]]; then
  case "$assignee" in
    none)
      account_id=""
      assignee_name=""
      ;;
    me)
      myself="$(api "rest/api/2/myself")"
      account_id="$(jq --raw-output '.accountId' <<<"$myself")"
      assignee_name="$(jq --raw-output '.displayName' <<<"$myself")"
      ;;
    *)
      assignee_name="$assignee"
      query="$(jq --null-input --raw-output --arg q "$assignee_name" '$q | @uri')"
      # The search is fuzzy, so keep only the exact display name.
      users="$(
        api "rest/api/2/user/assignable/search?issueKey=$key&query=$query" \
          | jq --arg n "$assignee_name" '[.[] | select(.active and .displayName == $n)]'
      )"
      if [[ "$(jq length <<<"$users")" -ne 1 ]]; then
        echo "Jira has no single assignable user for $key with the name $assignee_name." >&2
        echo "If the name changed in Jira, update the team list in jira-update and SKILL.md." >&2
        exit 2
      fi
      account_id="$(jq --raw-output '.[0].accountId' <<<"$users")"
      assignee_name="$(jq --raw-output '.[0].displayName' <<<"$users")"
      ;;
  esac
  if [[ "$(jq --raw-output '.fields.assignee.accountId // ""' <<<"$issue")" == "$account_id" ]]; then
    skipped+=("The assignee of $key is already ${assignee_name:-nobody}.")
  else
    body="$(jq --null-input --compact-output --arg id "$account_id" '{accountId: (if $id == "" then null else $id end)}')"
    if [[ -n "$account_id" ]]; then
      requests+=("PUT${sep}rest/api/2/issue/$key/assignee$sep$body${sep}Assigned the issue to $assignee_name.")
    else
      requests+=("PUT${sep}rest/api/2/issue/$key/assignee$sep$body${sep}Removed the assignee.")
    fi
  fi
fi

# Change the status last, so a comment explains the change before the issue closes.
# The transitions depend on the workflow and the current status. Match the target status by name, without case.
if [[ -n "$transition" ]]; then
  current_status="$(jq --raw-output '.fields.status.name' <<<"$issue")"
  if [[ "$(tr '[:upper:]' '[:lower:]' <<<"$current_status")" == "$(tr '[:upper:]' '[:lower:]' <<<"$transition")" ]]; then
    skipped+=("The status of $key is already $current_status.")
  else
    transitions="$(api "rest/api/2/issue/$key/transitions")"
    found="$(
      jq --raw-output --arg s "$transition" '
        [.transitions[] | select((.to.name | ascii_downcase) == ($s | ascii_downcase))]
        | first // empty | "\(.id)\t\(.to.name)"' <<<"$transitions"
    )"
    if [[ -z "$found" ]]; then
      echo "Cannot move $key from $current_status to $transition." >&2
      echo "Allowed statuses: $(jq --raw-output '[.transitions[].to.name] | unique | join(", ")' <<<"$transitions")" >&2
      exit 2
    fi
    IFS=$'\t' read -r transition_id status_name <<<"$found"
    body="$(jq --null-input --compact-output --arg id "$transition_id" '{transition: {id: $id}}')"
    requests+=("POST${sep}rest/api/2/issue/$key/transitions$sep$body${sep}Changed the status from $current_status to $status_name.")
  fi
fi

if [[ "$dry_run" == true ]]; then
  echo "Dry run for $key. Nothing is changed in Jira."
  for request in ${requests[@]+"${requests[@]}"}; do
    IFS="$sep" read -r method path body summary <<<"$request"
    echo
    echo "$method $base_url/$path"
    [[ -z "$body" ]] || jq . <<<"$body"
    echo "Change: $summary"
  done
  for line in ${skipped[@]+"${skipped[@]}"}; do echo "Skipped: $line"; done
  (( ${#requests[@]} > 0 )) || echo "Nothing to change."
  exit 0
fi

for line in ${skipped[@]+"${skipped[@]}"}; do echo "Skipped: $line"; done
if (( ${#requests[@]} == 0 )); then
  echo "Nothing to change on $key."
  exit 0
fi
# Print each change after its request succeeds, so a failure shows what is already done.
echo "Changes to $key ($base_url/browse/$key):"
for request in ${requests[@]+"${requests[@]}"}; do
  IFS="$sep" read -r method path body summary <<<"$request"
  send "$method" "$path" "$body" >/dev/null
  echo "- $summary"
done
