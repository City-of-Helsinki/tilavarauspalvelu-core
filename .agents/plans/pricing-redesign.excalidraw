      "seed": 1945614991,
      "version": 29,
      "versionNonce": 1961901383,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 8,
      "text": "Pricing redesign\n\n- Green: new. \n- Black: existing.\n- Red: removed.\n- Crow's foot: the 'many' side.\n- Bar: the 'one' side.\n- Crow's foot at both ends: many-to-many.\n- Dashed: nullable.\n- '?' after a field: nullable.\n- '+' added field.\n- '-' removed field.\n\nNot drawn:\n- ReservationUnit -> PaymentMerchant (optional)",
      "originalText": "Pricing redesign\n\n- Green: new. \n- Black: existing.\n- Red: removed.\n- Crow's foot: the 'many' side.\n- Bar: the 'one' side.\n- Crow's foot at both ends: many-to-many.\n- Dashed: nullable.\n- '?' after a field: nullable.\n- '+' added field.\n- '-' removed field.\n\nNot drawn:\n- ReservationUnit -> PaymentMerchant (optional)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "customData": {
        "agentVersion": 29
      }
    },
