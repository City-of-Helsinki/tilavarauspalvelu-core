{
  "name": "tilavaraus",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "preinstall": "sh ./scripts/enforce-pm.sh",
    "test:browser:ci": "cd apps/ui && pnpm run test:browser:ci",
    "dev:test": "cd apps/ui && pnpm run dev:test",
    "clean": "npkill",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix --type-aware --type-check",
    "lint:css": "pnpm -r run lint:css",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:staged": "oxfmt --no-error-on-unmatched-pattern",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:coverage": "pnpm -r run test:coverage",
    "gql-pluck": "node scripts/gql-pluck.mjs",
    "codegen:staff": "graphql-codegen --project staff",
    "codegen:customer": "graphql-codegen --project customer",
    "codegen:ui": "graphql-codegen --project ui",
    "codegen": "parallel pnpm ::: codegen:staff codegen:customer codegen:ui",
    "codegen:watch": "pnpm codegen:staff --watch & pnpm codegen:customer --watch & pnpm codegen:ui --watch"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.9",
    "@graphql-codegen/typescript-react-apollo": "^5.0.0",
    "@graphql-tools/graphql-tag-pluck": "^8.3.39",
    "@parcel/watcher": "^2.6.0",
    "glob": "^13.0.0",
    "graphql-config": "^5.1.7",
    "husky": "^9.1.7",
    "npkill": "^0.12.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "npm": "pnpm"
  },
  "packageManager": "pnpm@11.3.0"
}
