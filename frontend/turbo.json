{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "env": ["SENTRY_*", "NEXT_PUBLIC_SENTRY_*", "SKIP_ENV_VALIDATION", "FEEDBACK_URL"],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint:css": {},
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "test": {
      "env": ["SKIP_ENV_VALIDATION"],
      "inputs": ["**/*.tsx", "**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
    },
    "test:coverage": {
      "cache": false,
      "env": ["CI", "SKIP_ENV_VALIDATION"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
