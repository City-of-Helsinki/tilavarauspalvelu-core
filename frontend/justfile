# Make binaries from node_modules available to recipes
export PATH := module_directory() + "/node_modules/.bin:" + env("PATH")

import? 'local.just'

# List all available commands
help:
    @just --list

# Install dependencies
install:
    @pnpm install

# Remove node_modules directories
clean-deps:
    @npkill

# Remove cache (.next) directories
clean-cache:
    @pnpm -r run clean:cache

# Run all apps in development mode
dev:
    @pnpm -r --parallel run dev

# Build all apps
build:
    @pnpm -r run build

# Run all apps in production mode. Run build first.
start:
    @pnpm -r --parallel run start

# List outdated dependencies
outdated:
    @-pnpm -r outdated

# Update a dependency in all packages. Add @latest for a major version.
update package:
    @pnpm up -r {{ package }}

# Run linter and type check
lint:
    @oxlint --type-aware --type-check

# Run linter and type check, and fix issues
lint-fix:
    @oxlint --fix --type-aware --type-check

# Run CSS linter
lint-css:
    @pnpm -r run lint:css

# Run linter and fix issues on given files
lint-staged *files:
    @oxlint --fix --type-aware {{ files }}

# Format code
format:
    @pnpm -r run format

# Check code formatting
format-check:
    @pnpm -r run format:check

# Format given files
format-staged *files:
    @oxfmt --no-error-on-unmatched-pattern {{ files }}

# Run tests
test:
    @pnpm -r run test

# Run tests in watch mode for one package: customer, staff or ui
test-watch package:
    @pnpm --filter {{ package }} run test:watch

# Run tests with coverage
test-coverage:
    @pnpm -r run test:coverage

# Pluck GraphQL queries from source files
gql-pluck:
    @node scripts/gql-pluck.mjs

# Generate GraphQL types for staff app
codegen-staff *args:
    @graphql-codegen --project staff {{ args }}

# Generate GraphQL types for customer app
codegen-customer *args:
    @graphql-codegen --project customer {{ args }}

# Generate GraphQL types for ui package
codegen-ui *args:
    @graphql-codegen --project ui {{ args }}

# Generate all GraphQL types
[parallel]
codegen: codegen-staff codegen-customer codegen-ui

# Generate all GraphQL types in watch mode
codegen-watch:
    @graphql-codegen --project staff --watch & graphql-codegen --project customer --watch & graphql-codegen --project ui --watch
