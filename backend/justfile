import? 'local.just'

# List all available commands
help:
    @just --list

# Run a local celery worker and beat scheduler
celery:
    @celery -A config worker --beat --loglevel=INFO --scheduler=django

# Check if translations are up to date
check-translations:
    @python -m config.hooks.translations_done

# Reset database
clear-db schema='public':
    @python manage.py dbshell -- -c "DROP SCHEMA {{ schema }} CASCADE;CREATE SCHEMA {{ schema }};"

# Run tests with coverage and show the coverage report. Skips slow tests.
[positional-arguments]
coverage *args:
    @{{ pytest }} --no-migrations --reuse-db --skip-slow -n {{ pytest_workers }} --cov --cov-report=term "$@"

# Show files without full test coverage. Run 'coverage' first.
coverage-missing:
    @coverage report --skip-covered --show-missing

# Print outdated top level dependencies
deps-out:
    @poetry show --outdated --top-level

# Print all dependencies as a tree
deps-tree:
    @poetry show --tree

# Run local backend
dev:
    @python manage.py runserver localhost:8000

# Flush database
flush-db:
    @python manage.py flush --no-input

# Generate test data via a script
generate:
    @python manage.py create_test_data

# Add pre-commit hooks
hooks:
    @pre-commit install

# Install all dependencies and remove packages that are not in the lock file
install:
    @poetry sync

# Run pre-commit hooks
lint:
    @pre-commit run --all-files

# Update the lock file from pyproject.toml
lock:
    @poetry lock

# Run database migrations
migrate:
    @python manage.py migrate

# Compile database migrations
migrations:
    @python manage.py makemigrations

# Run a local celery beat scheduler
scheduler:
    @celery -A config beat --loglevel=INFO --scheduler=config.celery.beat:VaraamoDatabaseScheduler

# Update the GraphQL schema file
schema:
    @python manage.py update_graphql_schema

# Use pyproject.toml so that the git-ignored pytest.ini does not add its own options.
pytest := "pytest -c pyproject.toml --disable-warnings"
pytest_workers := env("PYTEST_WORKERS", "8")

# Run tests. Skips slow tests and migrations. Reuses the test database.
[positional-arguments]
test *args:
    @{{ pytest }} --no-migrations --reuse-db --skip-slow -n {{ pytest_workers }} "$@"

# Run tests, including slow tests
[positional-arguments]
test-all *args:
    @{{ pytest }} --no-migrations --reuse-db -n {{ pytest_workers }} "$@"

# Run tests with migrations. Skips slow tests.
[positional-arguments]
test-migrate *args:
    @{{ pytest }} --reuse-db --skip-slow -n {{ pytest_workers }} "$@"

# Recreate the test database with migrations, then run tests. Skips slow tests.
[positional-arguments]
test-fresh *args:
    @{{ pytest }} --create-db --reuse-db --skip-slow -n {{ pytest_workers }} "$@"

# Run only frontend query tests
[positional-arguments]
test-frontend-query *args:
    @{{ pytest }} --no-migrations --reuse-db --only-frontend-query-tests "$@"

# Compile translation strings
translate:
    @echo ""
    @echo Compiling translations...
    @python manage.py compilemessages
    @echo ""
    @echo Done!

# Fetch all translation strings under ./locale/
translations:
    @echo ""
    @echo Making translations...
    @python manage.py maketranslations -l fi -l sv --no-obsolete --omit-header --add-location file
    @echo ""
    @echo Done!

# Run a local celery worker
worker:
    @celery -A config worker --loglevel=INFO
