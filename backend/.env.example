# Example environment file for development

DATABASE_URL=postgis://tvp:tvp@127.0.0.1:5432/tvp
REDIS_URL=redis://127.0.0.1:6379/0

QUERY_LOGGING_ENABLED=false
#QUERY_LOGGING_SKIP_ROUTES=/admin,/static
#PREFILL_RESERVATION_WITH_PROFILE_DATA=True

CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:3001,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:3001,http://localhost:8080

TUNNISTAMO_BASE_URL=https://tunnistus.test.hel.ninja/auth/realms/helsinki-tunnistus
TUNNISTAMO_ADMIN_KEY=tilavaraus-dev
TUNNISTAMO_ADMIN_SECRET=
TUNNISTAMO_AUDIENCE=https://api.hel.fi/auth/tilavarausapidev
TUNNISTAMO_ISSUER=https://tunnistus.test.hel.ninja/auth/realms/helsinki-tunnistus

# Set to true to turn off username and password login to the Django admin.
HELUSERS_PASSWORD_LOGIN_DISABLED=false

OPEN_CITY_PROFILE_GRAPHQL_API=https://profile-api.test.hel.ninja/graphql/
OPEN_CITY_PROFILE_SCOPE=profile-api-test

HAUKI_API_URL=https://hauki-api.test.hel.ninja
HAUKI_ADMIN_UI_URL=http://hauki-admin-ui.test.hel.ninja
HAUKI_ORIGIN_ID=tvp
HAUKI_ORGANISATION_ID=tprek:336f3f23-70ee-4d53-bbd7-9bf92bf0690c
# Set to true to send a reservation unit to Hauki as a resource when staff save it. The code default is false.
#HAUKI_EXPORTS_ENABLED=true
HAUKI_SECRET=
HAUKI_API_KEY=

VERKKOKAUPPA_API_KEY=
VERKKOKAUPPA_NAMESPACE=tilanvaraus_dev
VERKKOKAUPPA_MERCHANT_API_URL=https://checkout-test-api.test.hel.ninja/v1/merchant
VERKKOKAUPPA_ORDER_API_URL=https://checkout-test-api.test.hel.ninja/v1/order
VERKKOKAUPPA_PAYMENT_API_URL=https://checkout-test-api.test.hel.ninja/v1/payment
VERKKOKAUPPA_PRODUCT_API_URL=https://checkout-test-api.test.hel.ninja/v1/product
# The mock replaces the web shop. Set it to false to use the test web shop with an API key.
MOCK_VERKKOKAUPPA_API_ENABLED=true
MOCK_VERKKOKAUPPA_FRONTEND_URL=http://localhost:3000
MOCK_VERKKOKAUPPA_BACKEND_URL=http://localhost:8000
# Set to true to create a payment order with a due date when staff approve a paid reservation that
# requires handling. If false, approval creates no payment order and the customer sees no payment notice.
PAYMENT_ORDERS_FOR_HANDLED_RESERVATIONS_ENABLED=true

PINDORA_API_URL=https://admin.test.ovaa.fi/api/integration/varaamo/
PINDORA_API_KEY=

TPREK_UNIT_URL=https://www.hel.fi/palvelukarttaws/rest/v4/unit/

# Minutes after an application round is handled before its reservation creation is shown as failed,
# if no reservation series exist yet. The code default is 10.
APPLICATION_ROUND_RESERVATION_CREATION_TIMEOUT_MINUTES=1

# Enable Sentry and set a DSN to send errors and traces to Sentry.
#SENTRY_ENABLED=true
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=local
#SENTRY_TRACES_SAMPLE_RATE=1.0
