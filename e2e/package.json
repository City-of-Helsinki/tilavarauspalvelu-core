{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end tests for Varaamo, ported from the tilavarauspalvelu-robot Robot Framework suite",
  "type": "module",
  "scripts": {
    "test": "playwright test --grep-invert @serialonly --project 'Tests_*' --project create_data",
    "test:smoke": "playwright test --grep @smoke --project Tests_user_desktop_FI --project Tests_admin_desktop_FI",
    "test:notifications": "playwright test --project Tests_admin_notifications_serial --workers 1",
    "test:all": "pnpm test; suites=$?; pnpm test:all:notifications; notifications=$?; exit $((suites || notifications))",
    "test:all:notifications": "PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-report/notifications PLAYWRIGHT_JUNIT_OUTPUT_FILE=test-results/notifications/junit.xml pnpm test:notifications --output test-results/notifications",
    "test:sequential": "FORCE_SINGLE_USER=True playwright test --grep-invert @serialonly --project 'Tests_*' --project create_data --workers 1",
    "test:unit": "playwright test --project unit",
    "list": "playwright test --list",
    "report": "playwright show-report",
    "e2e:install-deps": "playwright install --with-deps chromium firefox webkit",
    "codegen": "graphql-codegen",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.2",
    "graphql": "^16.14.2",
    "graphql-config": "^5.1.8",
    "graphql-tag": "^2.12.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "zod": "^4.6.5"
  },
  "engines": {
    "npm": "pnpm"
  },
  "packageManager": "pnpm@11.3.0"
}
