{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The settings of frontend/packages/tsconfig/base.json (Node 24), for a project of its own
  "compilerOptions": {
    "target": "es2024",
    // Page functions passed to evaluate() run in the browser
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    // A stray return in a keyword would skip its remaining steps without failing the test
    "allowUnreachableCode": false,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report", "blob-report"]
}
