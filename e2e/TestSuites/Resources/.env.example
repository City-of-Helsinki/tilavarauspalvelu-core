# Copy to .env in this directory and fill in the secrets. Variables already in the environment win.
# These are all the suite's settings (lib/env.ts). The commented-out ones show their defaults.

WAF_BYPASS_SECRET=
ROBOT_API_TOKEN=
DJANGO_ADMIN_PASSWORD=

# The test data endpoint
# ROBOT_API_ENDPOINT=/v1/create_robot_test_data/
# Parallel workers, and the retries of a failed test
# WORKERS=5
# RETRIES=1
# true: all tests use the same shared users. Use it with one worker, like pnpm test:sequential
# FORCE_SINGLE_USER=false
# true: a HAR file of each browser context in the test's results folder
# ENABLE_HAR_RECORDING=false
# A Playwright trace mode, like on or retain-on-failure. Ignored when CI is set
# PW_TRACE=off
# The lowest level of the log() messages in the report: DEBUG, INFO, WARN or ERROR
# LOG_LEVEL=INFO
# json: the log() messages that go to the console are JSON lines
# LOG_FORMAT=text
# The folder of the locks between the workers (default: .shared-state in e2e/)
# SHARED_STATE_DIR=
# CI is set by CI services (any value): no traces, and test.only fails the run
